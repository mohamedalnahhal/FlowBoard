generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum PermissionType {
  ALLOW
  DENY
}


model User {
  id           String   @id @default(uuid()) @db.Uuid
  display_name String
  username     String
  email        String?
  phone_number String?
  password     String
  role         Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_groups   UserGroup[]
  user_teams    UserTeam[]
  task_members  TaskMember[]
  task_history  TaskHistory[]
  task_comments TaskComment[]
  created_tasks Task[]        @relation("TaskCreatedBy")

  @@map("users")
}

model Team {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_teams UserTeam[]
  boards     Board[]
  groups     Group[]

  @@map("teams")
}

model Group {
  id          String  @id @default(uuid()) @db.Uuid
  team_id     String  @db.Uuid
  all_members Boolean @default(false)

  team        Team        @relation(fields: [team_id], references: [id])
  user_groups UserGroup[]
  permissions Permission[]

  @@map("groups")
}

model UserTeam {
  user_id    String   @db.Uuid
  team_id    String   @db.Uuid
  role       Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])
  team Team @relation(fields: [team_id], references: [id])

  @@id([user_id, team_id])
  @@map("user_teams")
}

model UserGroup {
  user_id    String   @db.Uuid
  group_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User  @relation(fields: [user_id], references: [id])
  group Group @relation(fields: [group_id], references: [id])

  @@id([user_id, group_id])
  @@map("user_groups")
}

model Board {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  team_id    String      @db.Uuid
  status     BoardStatus
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  team       Team        @relation(fields: [team_id], references: [id])
  lists      List[]
  checklists Checklist[]
  labels     Label[]

  permissions Permission[]

  @@map("boards")
}

model List {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  board_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  board Board  @relation(fields: [board_id], references: [id])
  tasks Task[]

  permissions Permission[]

  @@map("lists")
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  list_id      String     @db.Uuid
  name         String
  description  String
  checklist_id String?    @db.Uuid
  created_by   String     @db.Uuid
  start_date   DateTime?
  end_date     DateTime?
  status       TaskStatus
  position     Int
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  list             List             @relation(fields: [list_id], references: [id])
  checklist        Checklist?       @relation(fields: [checklist_id], references: [id])
  creator          User             @relation("TaskCreatedBy", fields: [created_by], references: [id])
  task_members     TaskMember[]
  task_attachments TaskAttachment[]
  task_history     TaskHistory[]
  task_labels      TaskLabel[]
  task_comments    TaskComment[]

  permissions      Permission[]

  @@map("tasks")
}

model TaskMember {
  user_id String @db.Uuid
  task_id String @db.Uuid
  role    Int?

  user User @relation(fields: [user_id], references: [id])
  task Task @relation(fields: [task_id], references: [id])

  @@id([user_id, task_id])
  @@map("task_members")
}

model TaskAttachment {
  task_id       String @db.Uuid
  attachment_id String @db.Uuid

  task       Task       @relation(fields: [task_id], references: [id])
  attachment Attachment @relation(fields: [attachment_id], references: [id])

  @@id([task_id, attachment_id])
  @@map("task_attachments")
}

model TaskComment {
  id                String   @id @default(uuid()) @db.Uuid
  task_id           String   @db.Uuid
  user_id           String   @db.Uuid
  parent_comment_id String?  @db.Uuid
  content           String
  is_edited         Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  task           Task         @relation(fields: [task_id], references: [id])
  user           User         @relation(fields: [user_id], references: [id])
  parent_comment TaskComment?  @relation("CommentReplies", fields: [parent_comment_id], references: [id])
  replies        TaskComment[] @relation("CommentReplies")

  @@map("task_comments")
}

model TaskHistory {
  id       String @id @default(uuid()) @db.Uuid
  task_id  String @db.Uuid
  user_id  String @db.Uuid
  activity Json
  type     String

  task Task @relation(fields: [task_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@map("task_history")
}

model Checklist {
  id         String   @id @default(uuid()) @db.Uuid
  board_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  board           Board           @relation(fields: [board_id], references: [id])
  checklist_items ChecklistItem[]
  tasks           Task[]

  @@map("checklists")
}

model ChecklistItem {
  id           String   @id @default(uuid()) @db.Uuid
  checklist_id String   @db.Uuid
  name         String
  status       Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  checklist Checklist @relation(fields: [checklist_id], references: [id])

  @@map("checklist_items")
}

model Label {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  color      String
  board_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  board       Board       @relation(fields: [board_id], references: [id])
  task_labels TaskLabel[]

  @@map("labels")
}

model TaskLabel {
  task_id    String   @db.Uuid
  label_id   String   @db.Uuid
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  task  Task  @relation(fields: [task_id], references: [id])
  label Label @relation(fields: [label_id], references: [id])

  @@id([task_id, label_id])
  @@map("task_labels")
}

model Attachment {
  id   String @id @default(uuid()) @db.Uuid
  type String
  name String
  url  String

  task_attachments TaskAttachment[]

  @@map("attachments")
}

model Permission {
  id          String         @id @default(uuid()) @db.Uuid
  action      String
  type        PermissionType
  priority    Int            @default(0)
  description String?
  group_id    String         @db.Uuid

  board_id    String?        @db.Uuid
  list_id     String?        @db.Uuid
  task_id     String?        @db.Uuid

  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  group Group  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  board Board? @relation(fields: [board_id], references: [id], onDelete: Cascade)
  list  List?  @relation(fields: [list_id],  references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [task_id],  references: [id], onDelete: Cascade)

  @@index([group_id, action, board_id])
  @@index([group_id, action, list_id])
  @@index([group_id, action, task_id])
  @@map("permissions")
}
